#!/bin/sh
# Launch faplex from a checkout: runs the standalone build in dist/, rebuilding it when the source is newer.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$ROOT/dist/faplex"
if [ ! -x "$BIN" ] || [ -n "$(find "$ROOT/src" "$ROOT/scripts" "$ROOT/package.json" "$ROOT/bun.lock" -newer "$BIN" -print -quit)" ]; then
  (cd "$ROOT" && bun install --frozen-lockfile && bun run build) >&2 || exit 1
fi
exec "$BIN" "$@"
