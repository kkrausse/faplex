#!/bin/sh
# Launch faplex from any directory. Opened sessions run in their own cwd.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export FAPLEX_CWD="${FAPLEX_CWD:-$PWD}"
# Install dependencies when missing or when bun.lock changed since the last install (e.g. after a pull).
if ! cmp -s "$ROOT/bun.lock" "$ROOT/node_modules/.faplex-installed.lock" 2>/dev/null; then
  (cd "$ROOT" && bun install --frozen-lockfile >&2 && cp bun.lock node_modules/.faplex-installed.lock) || exit 1
fi
# Load the JSX plugin explicitly without changing the caller's working directory.
exec bun --preload "$ROOT/src/preload.ts" "$ROOT/src/main.tsx" "$@"
