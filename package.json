{
  "name": "faplex",
  "version": "0.1.2",
  "description": "Like `claude agents`, but for all your harnesses and all your machines: one status list for Claude Code, Codex and OpenCode sessions, each opened in its own CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkrausse/faplex.git"
  },
  "type": "module",
  "bin": {
    "faplex": "bin/faplex.js"
  },
  "files": [
    "bin/faplex.js",
    "dist/faplex.js",
    "schema.json"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "bun src/main.tsx",
    "check": "tsc --noEmit",
    "build": "bun scripts/build.ts bin",
    "build:npm": "bun scripts/build.ts npm",
    "schema": "bun scripts/schema.ts",
    "release": "bun scripts/release.ts",
    "prepublishOnly": "bun run check && bun run schema && bun run build:npm"
  },
  "dependencies": {
    "@opentui/core": "0.5.14"
  },
  "devDependencies": {
    "@opentui/solid": "0.5.14",
    "effect": "4.0.0-rc.117",
    "solid-js": "^1.9.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
